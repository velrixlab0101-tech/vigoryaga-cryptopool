# Local Node dev uses @prisma/adapter-pg (any Postgres). Production on
# Cloudflare Workers uses @prisma/adapter-neon — point this at your Neon URL.
DATABASE_URL=postgresql://user:password@localhost:5432/cryptolottery
NEXT_PUBLIC_ADMIN_WALLET=0xeA678265E9Bbd1FF70Fb32E6a48B3B7F2C07438c
# Server-side fallback for the admin wallet (used when NEXT_PUBLIC_ is unset)
ADMIN_WALLET=0xeA678265E9Bbd1FF70Fb32E6a48B3B7F2C07438c
# Local dev only: token accepted as `x-admin-token`; ignored in production
ADMIN_DEV_TOKEN=dev-admin

# Custodial payments: users send USDC/USDT directly to this address on BNB
# Smart Chain (BSC). Both tokens are sent to the same address.
# NEXT_PUBLIC_ is shown to buyers (deposit + QR); PAYMENT_ADDRESSES is the
# server-side allow-list used to verify deposits (comma-separated). It falls
# back to NEXT_PUBLIC_PAYMENT_ADDRESS, then to the built-in default address.
NEXT_PUBLIC_PAYMENT_ADDRESS=0x7396727C1edd2024Acc8Ee0cBE327535C179B464
PAYMENT_ADDRESSES=0x7396727C1edd2024Acc8Ee0cBE327535C179B464

# WalletConnect Cloud project id (https://cloud.walletconnect.com) — required
# for the wallet connect modal in production.
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=31d37559818350dcfa0cdf31a5d3a8cc

# RPC endpoint used server-side to verify deposits (optional, defaults to public BSC RPC)
BSC_RPC_URL=https://bsc-dataseed.binance.org
# Legacy public-referral percentage. Kept for compatibility only — the private
# creator program uses per-creator share rates set in the admin panel instead.
REFERRAL_PCT=5
# Origin allowed to call the API cross-origin (defaults to the production site)
ALLOWED_API_ORIGIN=https://cryptopool.pages.dev
# Disable Next.js anonymous telemetry
NEXT_TELEMETRY_DISABLED=1
