generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Draw {
  id                String    @id @default(cuid())
  title             String
  ticketPrice       Decimal   @default(1) @db.Decimal(20, 6)
  operatorFeePct    Decimal   @default(10) @db.Decimal(5, 2)
  startTime         DateTime
  closeTime         DateTime
  status            String    @default("draft")
  prizeStructure    Json      @default("[{\"tier\":1,\"pct\":50},{\"tier\":2,\"pct\":25},{\"tier\":3,\"pct\":15},{\"tier\":4,\"pct\":7},{\"tier\":5,\"pct\":3}]")
  potTotal          Decimal   @default(0) @db.Decimal(20, 6)
  operatorPaid      Boolean   @default(false)
  operatorTxHash    String?
  cancelledAt       DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  tickets           Ticket[]
  winners           Winner[]
}

model Ticket {
  id           String    @id @default(cuid())
  drawId       String
  buyerAddress String
  txHash       String
  chainId      Int       @default(56)
  token        String    @default("USDC")
  qty          Int
  amount       Decimal   @db.Decimal(20, 6)
  referrerCode String?
  refundTxHash String?
  refundedAt   DateTime?
  createdAt    DateTime  @default(now())
  draw         Draw      @relation(fields: [drawId], references: [id])

  @@unique([chainId, txHash])
}

model Winner {
  id           String   @id @default(cuid())
  drawId       String
  place        Int
  wallet       String
  amount       Decimal  @db.Decimal(20, 6)
  spent        Decimal  @default(0) @db.Decimal(20, 6)
  token        String?
  txHash       String?
  createdAt    DateTime @default(now())
  draw         Draw     @relation(fields: [drawId], references: [id])
}

model Referral {
  id            String   @id @default(cuid())
  code          String   @unique
  ownerAddress  String
  earnedCredits Decimal  @default(0) @db.Decimal(20, 6)
  createdAt     DateTime @default(now())
}
